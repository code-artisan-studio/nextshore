{
  "Serilog": {
    "Using": ["Serilog.Sinks.Console"],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
      }
    },
    "WriteTo": [{ "Name": "Console" }]
  },
  "Cors": {
    "Origins": "http://localhost:5173"
  },
  "AllowedHosts": "*"
}

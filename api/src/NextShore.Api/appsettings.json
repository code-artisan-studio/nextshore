{
  "Serilog": {
    "Using": [
      "Serilog.Sinks.Console"
    ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console"
      }
    ]
  },
  "Cors": {
    "Origins": "http://localhost:5173"
  },
  "AllowedHosts": "*",
  "Engine": {
    "NearEligibleMaxGaps": 2,
    "NearEligiblePointsRatio": 0.85,
    "StaleAfterDays": 90,
    "ExchangeRatesNote": "Units per 1 USD. APPROXIMATE PLACEHOLDERS \u2014 set real rates (env Engine__ExchangeRates__CAD etc.) before the demo.",
    "ExchangeRates": {
      "CAD": 1.38,
      "EUR": 0.86,
      "AUD": 1.53
    }
  },
  "Anthropic": {
    "ParseModel": "claude-haiku-5-5",
    "SummaryModel": "claude-sonnet-5-5",
    "ParseTimeout": "00:00:30",
    "SummaryTimeout": "00:00:20",
    "MaxRetries": 1
  }
}
